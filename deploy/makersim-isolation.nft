table inet makersim_vm_isolation {
  set blocked_v4 {
    type ipv4_addr
    flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
      169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
      192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
      224.0.0.0/3, @PUBLIC_GATEWAY@ }
  }
  chain host_input {
    type filter hook input priority -20; policy accept;
    iifname "virbr-msim" counter reject
  }
  chain guest_forward {
    type filter hook forward priority -20; policy accept;
    iifname "virbr-msim" meta nfproto ipv6 counter reject
    iifname "virbr-msim" ip saddr != 192.168.130.2 counter reject
    iifname "virbr-msim" ip daddr @blocked_v4 counter reject
    iifname "virbr-msim" fib daddr type local counter reject
    iifname "virbr-msim" ip daddr { 1.1.1.1, 1.0.0.1 } udp dport 53 accept
    iifname "virbr-msim" ip daddr { 1.1.1.1, 1.0.0.1 } tcp dport 53 accept
    iifname "virbr-msim" tcp dport { 80, 443, 7844 } accept
    iifname "virbr-msim" udp dport 7844 accept
    iifname "virbr-msim" counter reject
  }
}
